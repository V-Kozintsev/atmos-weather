{
  "name": "atmos-weather",
  "version": "2.2.1",
  "main": "desktop/main.cjs",
  "author": "Viktor Kozintsev / PuskWeb",
  "description": "Atmos — погода, прогноз и мини-панель для рабочего стола",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 9000",
    "dev": "npm run native:dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 9000",
    "test": "vitest run",
    "mobile:sync": "npm run build && cap sync",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "native:dev": "npm --prefix mobile run web -- --port 9002 --localhost",
    "native:android": "npm --prefix mobile run android",
    "native:typecheck": "npm --prefix mobile run typecheck",
    "dev:legacy": "vite --host 127.0.0.1 --port 9000",
    "build:web": "npm run native:typecheck && node scripts/build-expo-web.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/manrope": "^5.3.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "suncalc": "^2.0.2",
    "tz-lookup": "^6.1.25"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/suncalc": "^1.9.2",
    "@types/tz-lookup": "^6.1.2",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
